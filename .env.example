# Copy this file to .env and fill in real values before running:
#   docker compose up --build
# .env is read by docker-compose.yml only — it's separate from backend's
# application-dev/prod.properties and frontend's own .env (used by `npm run dev`).

# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=smart_money_manager
MYSQL_USER=smm_user
MYSQL_PASSWORD=change-me-user-password
MYSQL_PORT=3306

# ---------------- Backend ----------------
# dev = auto-creates the schema on a fresh database (see docker-compose.yml comments).
# Switch to prod only once the schema already exists and has been verified.
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# Generate a real secret before anything beyond local use, e.g.: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret-before-any-real-deployment
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Optional: leave blank to skip seeding an admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Admin

# Optional SMTP — without it, verification/reset links are just logged to the backend
# container's console instead of emailed (see README "Email in development").
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------- Frontend ----------------
FRONTEND_PORT=3000
# Public URL users land on — used for CORS and the links inside verification/reset emails.
FRONTEND_URL=http://localhost:3000
# Baked into the frontend build; the default relative path works with the bundled nginx
# reverse proxy (frontend/nginx.conf) and normally shouldn't need to change.
VITE_API_BASE_URL=/api
