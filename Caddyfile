# Used only by the production overlay (docker-compose.prod.yml). Caddy terminates HTTPS on
# 80/443 (auto-issuing and renewing a Let's Encrypt certificate for a real DOMAIN — or a
# locally-trusted one automatically, if DOMAIN is "localhost" or similar) and reverse-proxies
# everything to the frontend container, which in turn proxies /api/* on to the backend
# (see frontend/nginx.conf). See README "Deployment" for the full walkthrough.

{$DOMAIN} {
	reverse_proxy frontend:80
}
